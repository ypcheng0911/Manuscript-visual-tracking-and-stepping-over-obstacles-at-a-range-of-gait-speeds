   "source": [
    "from pathlib import Path # Modern way to handle paths\n",
    "import pandas\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.patches as patches\n",
    "from scipy.io import savemat\n",
    "\n",
    "subj_list = [\"D03\",\"D04\",\"D05\",\"D06\",\"D07\",\"D08\",\"D09\",\"D10\",\n",
    "             \"N02\",\"N03\",\"N04\",\"N05\",\"N06\",\"N07\",\"N08\",\"N09\",\"N10\"]\n",
    "#subj_list = [\"D01\",\"D02\",\"D03\",\"D04\",\"D05\",\"D06\",\"D07\",\"D08\",\"D09\",\"D10\",\n",
    "#             \"N01\",\"N02\",\"N03\",\"N04\",\"N05\",\"N06\",\"N07\",\"N08\",\"N09\",\"N10\"]\n",
    "Parentpath_eyetracking = Path(r\"<path_to_raw_data>\\Tobii pro lab export\\All parameters\")\n",
    "Parentpath_recording = Path(r\"<path_to_raw_data>\\Eye_tracking_videos\\Recording_info\")\n",
    "Parentpath_prediction = Path(r\"<path_to_raw_data>\\Eye_tracking_videos\")\n",
    "Mat_saving_path = '<path_to_processed_data>Eye_tracking_videos\\\\All_vars\\\\'\n",
    "\n",
    "framesize = (1920, 1080) # Use a tuple for fixed size\n",
    "\n",
    "for subj in subj_list:\n",
    "    ## Load subject level information (paths, recording summary)\n",
    "    subj_path_eyetracking = list(Parentpath_eyetracking.glob(f\"*{subj}\"))\n",
    "    sheets = sorted(list(subj_path_eyetracking[0].glob(\"*.xlsx\")))\n",
    "    ss = list(Parentpath_recording.glob(f\"{subj}\\\\summary.txt\"))\n",
    "    # Get Video name and corresponding Condition name\n",
    "    summary = np.genfromtxt(ss[0], dtype=str, encoding=None, delimiter=\",\")\n",
    "    All_cond = summary[:,1]\n",
    "\n",
    "    # --- Iterate through the video files of the current subject\n",
    "    \n",
    "    ### developing scripts (feed only one condition to the for loop)\n",
    "    # sheets_temp = [sheets[0]]\n",
    "    # for sheet_path in sheets_temp:\n",
    "    ###\n",
    "    \n",
    "    for sheet_path in sheets:\n",
    "        # --- Read gaze data from Tobii output ---\n",
    "        S = pandas.read_excel(sheet_path)\n",
    "        ## Alternative table option -- all parameters\n",
    "        #new_table = S[[\"Sensor\",\"Participant name\",\"Recording timestamp [μs]\",\"Gaze point X [MCS px]\",\"Gaze point Y [MCS px]\",\"Gaze point 3D X [HUCS mm]\",\"Gaze point 3D Y [HUCS mm]\",\"Gaze point 3D Z [HUCS mm]\",\n",
    "        # \"Gaze direction left X [HUCS norm]\",\"Gaze direction left Y [HUCS norm]\",\"Gaze direction left Z [HUCS norm]\",\"Gaze direction right X [HUCS norm]\",\"Gaze direction right Y [HUCS norm]\",\"Gaze direction right Z [HUCS norm]\",\n",
    "        # \"Pupil position left X [HUCS mm]\",\"Pupil position left Y [HUCS mm]\",\"Pupil position left Z [HUCS mm]\",\"Pupil position right X [HUCS mm]\",\"Pupil position right Y [HUCS mm]\",\"Pupil position right Z [HUCS mm]\",\n",
    "        # \"Pupil diameter left [mm]\",\"Pupil diameter right [mm]\",\"Pupil diameter filtered [mm]\",\"Validity left\",\"Validity right\",\"Eye movement type\",\"Gaze event duration [ms]\",\"Eye movement type index\",\"Fixation point X [MCS px]\",\"Fixation point Y [MCS px]\"]]\n",
    "        # -- core parameters\n",
    "        try:\n",
    "            new_table = S[[\"Sensor\",\"Participant name\",\"Recording timestamp [μs]\",\"Gaze point X [MCS px]\",\"Gaze point Y [MCS px]\"]]\n",
    "        except:\n",
    "            new_table = S[[\"Sensor\",\"Participant name\",\"Recording timestamp\",\"Gaze point X\",\"Gaze point Y\"]]\n",
    "        grouped_by_sensory = new_table.groupby(\"Sensor\")\n",
    "        eye_tracker_table = grouped_by_sensory.get_group(\"Eye Tracker\")\n",
    "        Condition = eye_tracker_table[\"Participant name\"].values[0]\n",
    "\n",
    "        # --- Find current condition in the recording summary ---\n",
    "        cond_idx = np.where(All_cond == Condition)\n",
    "        cur_video_name = summary[cond_idx,0][0][0]\n",
    "        cur_video_name = cur_video_name.replace(\"+\",\"-\")  # convert + back into -, not knowing why being changed at first place.\n",
    "        cur_video_name = cur_video_name.replace(\"/\",\"_\")  # convert + back into -, not knowing why being changed at first place.\n",
    "\n",
    "        # --- Read timestamps for video frames ---\n",
    "        # -- Here is the full frame counts\n",
    "        TS_txt = f\"{subj}\\\\{cur_video_name}.txt\"\n",
    "        TS = list(Parentpath_recording.glob(TS_txt))\n",
    "        timestamps = np.loadtxt(TS[0],skiprows=2)\n",
    "        num_videotimestamp = len(timestamps)\n",
    "\n",
    "        # --- Read prediction results ---\n",
    "        # -- Some predictions have missed frames, where no results were found, but the frame counts in filenames are correct\n",
    "        VP_txt = f\"{subj}\\\\{cur_video_name}.mp4\\\\labels\\\\*.txt\"\n",
    "        allframes_paths = sorted(list(Parentpath_prediction.glob(VP_txt)))\n",
    "        #num_frames = len(allframes_paths)\n",
    "\n",
    "        #if num_frames!=num_videotimestamp:\n",
    "            #raise TypeError(\"Number of frames does not agree.\")\n",
    "            \n",
    "        # -- Class 0: background, Class 1: path, Class 2: obstacle\n",
    "        # Initialize numpy arrays with NaN (Not a Number)\n",
    "        # Note: Shape is (num_frames, 4) for boxes, (num_frames, 1) for probabilities\n",
    "        # Using np.full is slightly more explicit than np.empty().fill()\n",
    "        box_0 = np.full((num_videotimestamp, 4), np.nan)\n",
    "        box_1 = np.full((num_videotimestamp, 4), np.nan)\n",
    "        box_2 = np.full((num_videotimestamp, 4), np.nan)\n",
    "        box_2_multi = np.full((num_videotimestamp, 4), np.nan)\n",
    "        p_0 = np.full((num_videotimestamp, 1), np.nan)\n",
    "        p_1 = np.full((num_videotimestamp, 1), np.nan)\n",
    "        p_2 = np.full((num_videotimestamp, 1), np.nan)\n",
    "        p_2_multi = np.full((num_videotimestamp, 1), np.nan)\n",
    "\n",
    "        # --- Iterate through the files using enumerate to get index 'i' (0-based) ---\n",
    "        for frame_path in allframes_paths:\n",
    "            # Get frame number from filename\n",
    "            fff = str(frame_path)\n",
    "            i = int(fff[fff.index('=_')+2:fff.index('.txt')])-1 # (convert from 1-based to 0-based)\n",
    "            # print(f\"Processing frame {i}: {frame_path.name}\") # Optional: for debugging\n",
    "            try:\n",
    "                M = np.loadtxt(frame_path, ndmin=2)\n",
    "\n",
    "                # Handle empty files (loadtxt might return an empty array with shape (0,) or (0, N))\n",
    "                if M.shape[0] == 0:\n",
    "                    # print(f\"Warning: File {frame_path.name} is empty or could not be parsed.\")\n",
    "                    continue # Skip to the next frame\n",
    "\n",
    "                # Check if array has expected number of columns (at least 6)\n",
    "                if M.shape[1] < 6:\n",
    "                    print(f\"Warning: File {frame_path.name} has unexpected format (shape: {M.shape}). Skipping.\")\n",
    "                    continue\n",
    "\n",
    "                c2_1st_found = False # Reset flag for each frame (file)\n",
    "                # Iterate through rows 'r' of the matrix M\n",
    "                for r in range(M.shape[0]):\n",
    "                    row_data = M[r, :]\n",
    "                    class_label = int(row_data[0]) # First column is class (convert to int)\n",
    "\n",
    "                    box_coords = row_data[1:5]\n",
    "                    probability = row_data[5]\n",
    "\n",
    "                    if class_label == 0:\n",
    "                        box_0[i, :] = box_coords\n",
    "                        p_0[i] = probability\n",
    "                    elif class_label == 1:\n",
    "                        box_1[i, :] = box_coords\n",
    "                        p_1[i] = probability\n",
    "                    elif class_label == 2:\n",
    "                        if not c2_1st_found:\n",
    "                            box_2[i, :] = box_coords\n",
    "                            p_2[i] = probability\n",
    "                            c2_1st_found = True\n",
    "                        else:\n",
    "                            box_2_multi[i, :] = box_coords\n",
    "                            p_2_multi[i] = probability\n",
    "\n",
    "            except Exception as e:\n",
    "                print(f\"Error processing file {frame_path.name}: {e}\")\n",
    "                # Decide if you want to continue or stop on error\n",
    "                # continue\n",
    "        frame_width = framesize[0]\n",
    "        frame_height = framesize[1]\n",
    "\n",
    "        # --- Scaling for box_0, box_1, box_2, box_2_multi ---\n",
    "        # Multiply columns 0 and 2 (x_center, width) by frame_width\n",
    "        box_0[:, [0, 2]] *= frame_width\n",
    "        # Multiply columns 1 and 3 (y_center, height) by frame_height\n",
    "        box_0[:, [1, 3]] *= frame_height\n",
    "        box_1[:, [0, 2]] *= frame_width\n",
    "        box_1[:, [1, 3]] *= frame_height\n",
    "        box_2[:, [0, 2]] *= frame_width\n",
    "        box_2[:, [1, 3]] *= frame_height\n",
    "        box_2_multi[:, [0, 2]] *= frame_width\n",
    "        box_2_multi[:, [1, 3]] *= frame_height\n",
    "\n",
    "        # --- Upsample the bounding box coordinate data streams to 4 times (matching the eye tracking data stream)\n",
    "        def upsample_with_nan(InputNParray,n):\n",
    "            import math\n",
    "            import numpy as np\n",
    "            from scipy import signal\n",
    "            ## Upsample [InputNParray] by [n] times.\n",
    "            total_len = np.shape(InputNParray)[0]\n",
    "            dimensions = len(np.shape(InputNParray))\n",
    "            if total_len > 30:\n",
    "                if dimensions == 2:\n",
    "                    fz = np.full((total_len*n, 4), np.nan)\n",
    "                elif dimensions == 1:\n",
    "                    fz = np.full((total_len*n), np.nan)\n",
    "                for epoch in range(math.ceil(total_len/30)):\n",
    "                    if epoch==math.ceil(total_len/30):\n",
    "                        if dimensions == 2:\n",
    "                            temp_input = InputNParray[epoch*30:,:]\n",
    "                        elif dimensions ==1:\n",
    "                            temp_input = InputNParray[epoch*30:]\n",
    "                        missing_data = np.argwhere(temp_input=='NaN')\n",
    "                        # --- Fill missing data with 0 to enable resample function\n",
    "                        for i,loc in enumerate(missing_data):\n",
    "                            temp_input[loc[0],loc[1]] = 0\n",
    "                        # Resample\n",
    "                        temp_fz = signal.resample(temp_input,np.shape(temp_input)[0]*n)\n",
    "                        # --- Put the missing values back to resampled data stream\n",
    "                        for i,loc in enumerate(missing_data):\n",
    "                            temp_fz[(loc[0])*(n-1)-1:(loc[0]+1)*n,loc[1]] = 'NaN'\n",
    "                        if dimensions == 2:\n",
    "                            fz[epoch*30*n:,:] = temp_fz\n",
    "                        elif dimensions == 1:\n",
    "                            fz[epoch*30*n:] = temp_fz\n",
    "                    else:\n",
    "                        if dimensions == 2:\n",
    "                            temp_input = InputNParray[0+epoch*30:(epoch+1)*30,:]\n",
    "                        elif dimensions ==1:\n",
    "                            temp_input = InputNParray[0+epoch*30:(epoch+1)*30]\n",
    "                        missing_data = np.argwhere(temp_input=='NaN')\n",
    "                        # --- Fill missing data with 0 to enable resample function\n",
    "                        for i,loc in enumerate(missing_data):\n",
    "                            temp_input[loc[0],loc[1]] = 0\n",
    "                        # Resample\n",
    "                        temp_fz = signal.resample(temp_input,np.shape(temp_input)[0]*n)\n",
    "                        # --- Put the missing values back to resampled data stream\n",
    "                        for i,loc in enumerate(missing_data):\n",
    "                            temp_fz[(loc[0])*(n-1)-1:(loc[0]+1)*n,loc[1]] = 'NaN'\n",
    "                        if dimensions == 2:\n",
    "                            fz[epoch*30*n:(epoch+1)*30*n:,:] = temp_fz\n",
    "                        elif dimensions == 1:\n",
    "                            fz[epoch*30*n:(epoch+1)*30*n:] = temp_fz\n",
    "            else:\n",
    "                missing_data = np.argwhere(InputNParray=='NaN')\n",
    "                # --- Fill missing data with 0 to enable resample function\n",
    "                for i,loc in enumerate(missing_data):\n",
    "                    InputNParray[loc[0],loc[1]] = 0\n",
    "                # Resample\n",
    "                fz = signal.resample(InputNParray,np.shape(InputNParray)[0]*n)\n",
    "                # --- Put the missing values back to resampled data stream\n",
    "                for i,loc in enumerate(missing_data):\n",
    "                    fz[(loc[0])*(n-1)-1:(loc[0]+1)*n,loc[1]] = 'NaN'\n",
    "            if dimensions == 2:\n",
    "                fz = fz[:-n+1,:]\n",
    "            elif dimensions == 1:\n",
    "                fz = fz[:-n+1]\n",
    "            return fz\n",
    "\n",
    "        n=4\n",
    "        box_0_up = upsample_with_nan(box_0,n)\n",
    "        box_1_up = upsample_with_nan(box_1,n)\n",
    "        box_2_up = upsample_with_nan(box_2,n)\n",
    "        box_2_multi_up = upsample_with_nan(box_2_multi,n)\n",
    "        timestamps_up = upsample_with_nan(timestamps,n)\n",
    "\n",
    "        # --- Check if gaze: [x, y] is in the box: [x center, y center, x width, y height] ---\n",
    "        def in_this_box(x,y,box):            \n",
    "            x_in = abs(x-box[0]) < box[2]/2\n",
    "            y_in = abs(y-box[1]) < box[3]/2\n",
    "            output = x_in==1 and y_in==1\n",
    "            return output\n",
    "        \n",
    "        # --- Process gaze data ---\n",
    "        timestamps /= 1000 # convert the unit to second\n",
    "        timestamps_up /= 1000 # convert the unit to second\n",
    "        cur_gaze_timestamp = np.full((len(timestamps_up), 1), np.nan)\n",
    "        gaze_x_px = np.full((len(timestamps_up), 1), np.nan)\n",
    "        gaze_y_px = np.full((len(timestamps_up), 1), np.nan)\n",
    "        gaze_in_box_0 = np.full((len(timestamps_up), 1), np.nan)\n",
    "        gaze_in_box_1 = np.full((len(timestamps_up), 1), np.nan)\n",
    "        gaze_in_box_2 = np.full((len(timestamps_up), 1), np.nan)\n",
    "        gaze_in_box_2m = np.full((len(timestamps_up), 1), np.nan)\n",
    "        for j,cur_frame_timestamp in enumerate(timestamps_up):\n",
    "            try:\n",
    "                gaze_timestamp = eye_tracker_table[\"Recording timestamp [μs]\"].values[:]/1000000 # convert the unit to second\n",
    "            except:\n",
    "                gaze_timestamp = eye_tracker_table[\"Recording timestamp\"].values[:]/1000000 # convert the unit to second\n",
    "            gaze_timestamp -= cur_frame_timestamp\n",
    "            gaze_timestamp = abs(gaze_timestamp)\n",
    "            gaze_timestamp = gaze_timestamp.tolist()\n",
    "            min_loc = gaze_timestamp.index(min(gaze_timestamp))\n",
    "\n",
    "            try:\n",
    "                cur_gaze_timestamp[j] = eye_tracker_table[\"Recording timestamp [μs]\"].values[min_loc]/1000000 # convert the unit to second\n",
    "                gaze_x_px[j] = eye_tracker_table[\"Gaze point X [MCS px]\"].values[min_loc] \n",
    "                gaze_y_px[j] = eye_tracker_table[\"Gaze point Y [MCS px]\"].values[min_loc]\n",
    "            except:\n",
    "                cur_gaze_timestamp[j] = eye_tracker_table[\"Recording timestamp\"].values[min_loc]/1000000 # convert the unit to second\n",
    "                gaze_x_px[j] = eye_tracker_table[\"Gaze point X\"].values[min_loc] \n",
    "                gaze_y_px[j] = eye_tracker_table[\"Gaze point Y\"].values[min_loc]\n",
    "            gaze_in_box_0[j] = in_this_box(gaze_x_px[j],gaze_y_px[j],box_0_up[j])\n",
    "            gaze_in_box_1[j] = in_this_box(gaze_x_px[j],gaze_y_px[j],box_1_up[j])\n",
    "            gaze_in_box_2[j] = in_this_box(gaze_x_px[j],gaze_y_px[j],box_2_up[j])\n",
    "            gaze_in_box_2m[j] = in_this_box(gaze_x_px[j],gaze_y_px[j],box_2_multi_up[j])\n",
    "\n",
    "        # --- Verification figure ---        \n",
    "        #fig, axs = plt.subplots(4)\n",
    "        #fig.suptitle(Condition)\n",
    "        #axs[0].plot(timestamps,gaze_in_box_0)\n",
    "        #axs[1].plot(timestamps,gaze_in_box_1)\n",
    "        #axs[2].plot(timestamps,gaze_in_box_2)\n",
    "        #axs[3].plot(timestamps,gaze_in_box_2m)\n",
    "\n",
    "        print(f\"Processing finished.\")\n",
    "\n",
    "        # --- Save variables in .mat format ---\n",
    "        try:\n",
    "            raw_gaze_timestamp = eye_tracker_table[\"Recording timestamp [μs]\"].values[:]/1000000 # convert the unit to second\n",
    "            raw_gaze_x_px = eye_tracker_table[\"Gaze point X [MCS px]\"].values[:] \n",
    "            raw_gaze_y_px = eye_tracker_table[\"Gaze point Y [MCS px]\"].values[:]\n",
    "        except:\n",
    "            raw_gaze_timestamp = eye_tracker_table[\"Recording timestamp\"].values[:]/1000000 # convert the unit to second\n",
    "            raw_gaze_x_px = eye_tracker_table[\"Gaze point X\"].values[:] \n",
    "            raw_gaze_y_px = eye_tracker_table[\"Gaze point Y\"].values[:]\n",       
    "        filename_mat = Mat_saving_path + subj + Condition + '_upsample_summary.mat'\n",
    "        data_to_save = {\n",
    "            'subj': subj,\n",
    "            'Condition': Condition,\n",
    "            'cur_video_name': cur_video_name,\n",
    "            'box_0': box_0,\n",
    "            'p_0': p_0,\n",
    "            'box_1': box_1,\n",
    "            'p_1': p_1,\n",
    "            'box_2': box_2,\n",
    "            'p_2': p_2,\n",
    "            'box_2_multi': box_2_multi,\n",
    "            'p_2_multi': p_2_multi,\n",
    "            'box_0_up': box_0_up,\n",
    "            'box_1_up': box_1_up,\n",
    "            'box_2_up': box_2_up,\n",
    "            'box_2_multi_up': box_2_multi_up,\n",
    "            'framesize': np.array(framesize), # MATLAB prefers arrays\n",
    "            'timestamps': timestamps,\n",
    "            'timestamps_up': timestamps_up,\n",
    "            'cur_gaze_timestamp': cur_gaze_timestamp,\n",
    "            'gaze_x_px': gaze_x_px,\n",
    "            'gaze_y_px': gaze_y_px,\n",
    "            'gaze_in_box_0': gaze_in_box_0,\n",
    "            'gaze_in_box_1': gaze_in_box_1,\n",
    "            'gaze_in_box_2': gaze_in_box_2,\n",
    "            'gaze_in_box_2m': gaze_in_box_2m,\n",
    "            'raw_gaze_timestamp': raw_gaze_timestamp,\n",
    "            'raw_gaze_x_px': raw_gaze_x_px,\n",
    "            'raw_gaze_y_px': raw_gaze_y_px\n",
    "        }\n",
    "        savemat(filename_mat, data_to_save)\n",
    "\n",
    "        print(f\"Data saved to {filename_mat}\")\n"
   ]
  },
