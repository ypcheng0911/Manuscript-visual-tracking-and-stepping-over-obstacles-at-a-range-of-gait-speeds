    "        # Resample\n",
    "        fz = signal.resample(InputNParray,np.shape(InputNParray)[0]*n)\n",
    "        # --- Put the missing values back to resampled data stream\n",
    "        for i,loc in enumerate(missing_data):\n",
    "            fz[(loc[0])*(n-1)-1:(loc[0]+1)*n,loc[1]] = 'NaN'\n",
    "    fz = fz[:-n+1,:]\n",
    "    return fz\n",
